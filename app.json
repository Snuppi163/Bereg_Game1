{
  "expo": {
    "name": "Тихий берег",
    "slug": "tikhiy-bereg",
    "version": "1.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./src/assets/farm/app-icon.png",
    "splash": {
      "image": "./src/assets/farm/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#e8d5a5"
    },
    "android": {
      "versionCode": 4,
      "package": "com.bereggame.tikhiybereg",
      "permissions": [
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/farm/app-icon.png",
        "backgroundColor": "#efcf87"
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
